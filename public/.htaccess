# Route every request that is not an existing file or directory to the
# front controller. Real assets (CSS, medias) keep being served directly.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L]
</IfModule>

# Response headers, applied to everything served from here.
# "always" so they also land on PHP/FastCGI responses, not just static files.
<IfModule mod_headers.c>
  # Don't let the browser guess a file's type against its Content-Type.
  Header always set X-Content-Type-Options "nosniff"
  # Don't allow the site to be embedded in an <iframe> elsewhere (clickjacking).
  Header always set X-Frame-Options "DENY"
  # Send only the origin as referrer to other sites.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Deny dotfiles here too (defensive; there should be none under public/).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

Options -Indexes
