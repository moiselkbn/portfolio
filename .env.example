# Copy this file to .env and fill in the real values. .env is never committed.

# "local" or "production" — controls error display. Never derive this from HTTP_HOST.
APP_ENV=local

# Database (MAMP defaults: host localhost, port 8889, user root, pass root)
DB_HOST=localhost
DB_PORT=8889
DB_NAME=portfolio_2026_v3
DB_USER=root
DB_PASS=root

# Contact form. CONTACT_TO receives the messages. CONTACT_FROM must be an address
# on our own domain (SPF) — the visitor's address goes in Reply-To, not From.
CONTACT_TO=you@example.com
CONTACT_FROM=contact@example.com
